R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=KLICKIFAX
VERSION=0.29.5
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
TARGET=/R4OS/SOFTWARE/INTERNET/KLICKIFAX.R4X
IMAGE_SCOPE=full
OPTIMIZE=speed
IMPORT=R4DESK:Query:1
IMPORT=R4DEV:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4FONT:API_V1:1
IMPORT=R4IMG:API_V1:1
IMPORT=R4NET:Query:1
IMPORT=R4SYS:Query:1
ZIG_MODULE=r4img:../../Libraries/R4IMG/Bindings/Zig/r4img.zig
ZIG_MODULE=app_fonts:../../Libraries/R4FONT/Bindings/Zig/app_fonts.zig
HELP=Assets/Help.txt
ICON=Assets/Desktop.ico
RESOURCE=LOADING.PNG:Assets/Loading.png
META=feature=html-document-core
META=feature=css-cascade
META=feature=responsive-layout
META=feature=cooperative-javascript-pump
META=feature=javascript-source-diagnostics
META=feature=browser-data-layout
META=feature=legacy-storage-migration
META=feature=complete-url-api
META=feature=complete-encoding-api
META=feature=complete-headers-api
META=feature=complete-response-api
META=feature=complete-request-api
META=feature=complete-abort-api
META=feature=complete-fetch-api
META=feature=complete-streams-api
META=feature=complete-dom-api
META=feature=mutation-observer
META=feature=complete-history-location
META=feature=navigation-api
META=feature=navigation-timing
META=feature=document-resource-lifecycle
META=feature=responsive-web-images
META=feature=data-image-urls
META=feature=css-background-images
META=feature=image-resource-observer
META=feature=web-font-face-registry
META=feature=document-font-resource-lifecycle
META=feature=content-addressed-font-cache
META=feature=persistent-font-cache
META=feature=document-webfont-rendering
META=feature=webfont-display-lifecycle
META=feature=isolated-subdocuments
META=feature=module-resource-graph
META=feature=same-origin-frame-dom
META=feature=r4os-browser-environment
META=feature=opt-in-browser-diagnostics
META=feature=web-crypto-sha256
META=feature=canvas-2d-software
META=feature=scrollable-document
META=feature=embedded-loading-view
META=feature=web-raster-images
META=feature=web-svg-images
META=feature=inline-svg-links
META=feature=html-get-forms
META=feature=dom-events
META=feature=document-navigation
META=feature=javascript-runtime-foundation
META=feature=javascript-web-bindings
META=feature=origin-security
META=feature=web-storage
META=memory.profile=browser
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:DATE_V1:1
IMPORT=R4STD:TIME_V1:1
ZIG_MODULE=r4std:../../Libraries/R4STD/Bindings/Zig/r4std.zig
